{
  "name": "bluetify",
  "version": "2.0.0",
  "private": true,
  "description": "Last.fm integration for Bluesky bio",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "npm run typecheck && tsx --test test/*.test.ts",
    "start": "node --env-file=.env dist/index.js",
    "dev": "tsx watch --env-file=.env src/index.ts"
  },
  "dependencies": {
    "@atproto/api": "^0.20.30"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
